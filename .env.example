# Solana localnet (NO mainnet)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_PREDCA_PROGRAM_ID=HajLzgcp6fyHVgVLFtwujnU53re47PSMJcQZZes8ZvbU

# USDC mint is an instruction account (not hardcoded in the program).
# Leave empty until you create a mock mint on localnet, then set it, e.g.:
#   spl-token create-token --decimals 6
#   NEXT_PUBLIC_USDC_MINT=<mint pubkey>
NEXT_PUBLIC_USDC_MINT=

# Klucze API — tylko referencja lokalna/dev.
# UI preferuje BYOK w localStorage (Ustawienia):
#   prestocks.TYPESAFE_API_KEY
#   prestocks.XAI_API_KEY
# Nie commituj prawdziwych wartości.
TYPESAFE_API_KEY=
XAI_API_KEY=

# Domyślny klucz Jev dla publicznego demo (playground).
# Next wstawia NEXT_PUBLIC_* do bundla klienta — wartość da się wyjąć z JS na Pages.
# Zostaw puste w gicie. Prawdziwą wartość ustaw tylko w CI albo w .env.local (gitignore).
# UI zapisuje ją do prestocks.TYPESAFE_API_KEY tylko gdy tego klucza jeszcze nie ma.
# Zapis pustego pola (wyczyszczenie) nie jest nadpisywany.
NEXT_PUBLIC_TYPESAFE_DEFAULT_KEY=

# Public keeper (rank API /keeper proxy)
NEXT_PUBLIC_KEEPER_URL=

# Privy — public App ID only. Do not put the App Secret in this repo.
# Dashboard: Solana Devnet, embedded wallets ON, login email + Google.
# Allowed origins: https://krzysztofpazdyk.github.io and http://localhost:3000
# Empty is OK until the ID is set. Pages inlines this at build time.
NEXT_PUBLIC_PRIVY_APP_ID=

# Jupiter Price API v3 (mainnet PreStocks). Optional — the app defaults to
# https://lite-api.jup.ag/price/v3 when this is unset. No API key.
# NEXT_PUBLIC_JUP_PRICE_URL=https://lite-api.jup.ag/price/v3
