# Public DEVNET-only config for GitHub Pages static build (no secrets).
# Use public Solana Devnet RPC (Helius requires api-key → 401 without it).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PREDCA_PROGRAM_ID=Eb3TFLeYi3dHZwoKCBvvUpx3gMnP2XdmMXX3rstUpdwC
NEXT_PUBLIC_USDC_MINT=3xtTBfHRf8AKEmhbFYqRoXfi9RaxxiqG9YfifjCjD4qm

# Keeper / DCA API. Leave empty in git.
# The value is injected only at build time (Pages / CI). An empty URL is graceful:
# the client skips keeper calls until a URL is set.
NEXT_PUBLIC_DCA_API_URL=
NEXT_PUBLIC_KEEPER_URL=

NEXT_PUBLIC_BASE_PATH=/prestocks-dca-noir

# Demo TypeSafe key for the public playground. Leave empty in git.
# Set NEXT_PUBLIC_TYPESAFE_DEFAULT_KEY in the Pages build environment only.
# NEXT_PUBLIC_* is inlined into the client bundle and can be extracted from Pages JS.
# Unset or empty → Settings stays empty (no free Jev). Do not commit the raw key.
NEXT_PUBLIC_TYPESAFE_DEFAULT_KEY=

# Public Privy App ID (not the App Secret). Leave empty until set before a Pages build.
# Dashboard: Solana Devnet, embedded wallets on, email + Google.
# Origins: https://krzysztofpazdyk.github.io and http://localhost:3000
NEXT_PUBLIC_PRIVY_APP_ID=
